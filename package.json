    "legacy:security:db": "tsx scripts/security-db-check.ts",
    "legacy:security:data-api": "tsx scripts/security-data-api-check.ts",
    "legacy:security:db-regression": "tsx scripts/security-db-regression.ts",
    "legacy:security:tls": "tsx scripts/security-tls-check.ts",
