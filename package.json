    "security:secrets:check": "node --test scripts/security-secret-check.test.mjs",
    "firebase:hosting-check": "node --require ./scripts/testing/server-only.cjs --import tsx scripts/firebase-hosting-check.ts",
    "payment:reconciliation-check": "node --require ./scripts/testing/server-only.cjs --import tsx scripts/payment-reconciliation-check.ts",
