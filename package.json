  "dependencies": {
    "@portone/browser-sdk": "^0.1.3",
    "@portone/server-sdk": "^0.19.0",
    "@tanstack/react-query": "^5.90.21",
    "firebase-admin": "^14.5.0",
    "lunar-javascript": "^1.7.7",
    "next": "16.4.2",
    "openai": "^6.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
