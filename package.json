  "overrides": {
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "@prisma/config": {
      "effect": "^3.22.2",
      "deepmerge-ts": "^8.0.2"
    },
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-glob": "file:tools/eslint-root-glob",
    "pg": "^8.23.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": "22"
  }
}
