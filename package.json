{
  "name": "dabom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --conditions=react-server --import tsx scripts/firebase-production-check.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "saju:spike": "node scripts/saju-spike.mjs",
    "saju:compare": "node scripts/saju-compare.mjs",
    "saju:facts-check": "node --import tsx scripts/report-facts-check.ts",
    "saju:corpus-check": "node --require ./scripts/testing/server-only.cjs --import tsx scripts/report-corpus-check.ts",
    "report:personalization-check": "node --require ./scripts/testing/server-only.cjs --import tsx scripts/report-personalization-check.ts",
    "report:detail-check": "node --require ./scripts/testing/server-only.cjs --import tsx scripts/report-detail-check.ts",
    "report:presentation-check": "node --require ./scripts/testing/server-only.cjs --import tsx scripts/report-presentation-check.ts",
    "report:readability-check": "node --import tsx scripts/report-readability-check.ts",
    "report:emoticons-check": "node --import tsx scripts/report-emoticons-check.ts",
    "report:check": "node --require ./scripts/testing/server-only.cjs --import tsx scripts/report-generation-check.ts",
    "library:check": "node --require ./scripts/testing/server-only.cjs --import tsx scripts/saju-library-check.ts",
    "auth:check": "node scripts/saju-auth-check.mjs",
    "security:check": "node --require ./scripts/testing/server-only.cjs --import tsx scripts/security-check.ts",
    "security:dependencies": "node --test scripts/security-dependencies-check.test.mjs",
    "payment:check": "node --import tsx scripts/payment-client-check.ts",
    "profile:check": "node --import tsx scripts/report-request-client-check.ts",
