# Neon (or another managed PostgreSQL) connection string. Never commit its value.
# Use the pooled URL supplied to Vercel for runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Use the unpooled URL only when running Prisma migrations from a trusted machine.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Added in later steps. Keep production values in the deployment provider only.
OPENAI_API_KEY=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
PORTONE_API_SECRET=""
PORTONE_STORE_ID=""
PORTONE_CHANNEL_KEY=""
