# Supabase → Connect에서 복사. Vercel 런타임에는 Transaction pooler(6543)를 쓴다.
# Prisma의 prepared statement를 끄기 위해 pgbouncer=true를 포함한다.
# 공식 CA는 prisma/certs/supabase-ca.crt에 포함되어 있다. 출처와 지문은 같은 폴더의 README 참고.
# 앱은 prisma/client.cjs의 공식 PostgreSQL 어댑터에서 TLS/CA/호스트 검증을 강제한다.
# URL의 SSL 옵션이 이 정책을 덮어쓸 수 없다. 보안 검사: npm run security:tls.
DATABASE_URL="postgresql://USER:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&sslaccept=strict&sslcert=certs/supabase-ca.crt"
# migration 전용 direct URL. CA 옵션을 포함하고 신뢰할 수 있는 Linux/CI 머신에서만 사용한다.
# Mac의 Prisma CLI 기본 TLS 엔진은 Supabase 인증서를 거부할 수 있다. 검증을 끄지 않는다.
SUPABASE_DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&sslaccept=strict&sslcert=certs/supabase-ca.crt"

# 카카오 로그인은 Supabase Authentication의 Kakao provider에서 설정한다.
NEXT_PUBLIC_SUPABASE_URL=""
# Settings → API Keys의 기존 Publishable key. 새 키 발급은 필요하지 않다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# 기존 배포의 anon key도 지원한다. Publishable key를 넣었다면 비워둔다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Keep production values in the deployment provider only.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-luna"
PORTONE_API_SECRET=""
PORTONE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=""
