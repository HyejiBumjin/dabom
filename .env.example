# Supabase → Connect에서 복사. Vercel 런타임에는 Transaction pooler(6543)를 쓴다.
# Prisma의 prepared statement를 끄기 위해 pgbouncer=true를 포함한다.
DATABASE_URL="postgresql://USER:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# migration 전용 direct URL. 신뢰할 수 있는 개발 머신에서만 사용한다.
SUPABASE_DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Added in later steps. Keep production values in the deployment provider only.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
PORTONE_API_SECRET=""
PORTONE_STORE_ID=""
PORTONE_CHANNEL_KEY=""
