NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Authentication + Firestore (server only)
FIREBASE_PROJECT_ID="dabom-10a35"
# Local Admin key: chmod 600. secrets/ is excluded from Git.
FIREBASE_ADMIN_CREDENTIALS_FILE="./secrets/firebase-admin.json"
# Vercel deployment: configure JSON as a secret instead of FILE. Use exactly one source.
# Never prefix Admin credentials with NEXT_PUBLIC_.
# FIREBASE_ADMIN_CREDENTIALS_JSON=""
# App Hosting uses application-default mode in apphosting.yaml instead of either key source.
FIREBASE_WEB_API_KEY=""

# Existing Kakao Developers app: REST API key + active client secret.
# Register APP_URL/api/auth/callback as a redirect URI.
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""

# Keep production values in the deployment provider only.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-luna"
PORTONE_API_SECRET=""
PORTONE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=""
# Local payment rehearsal only: isolated payment_test_* collections, TEST channels,
# and payment required before generating a report. Never enable on a hosted deployment.
DABOM_PAYMENT_TEST_MODE="false"
