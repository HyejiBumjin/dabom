{
  "name": "Dabom login rate limit",
  "description": "Limit OAuth starts before app/Firestore access. Excludes OAuth callback, report polling and payment webhooks.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        { "type": "path", "op": "re", "value": "^/api/auth/login/?$" }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 600,
        "limit": 30,
        "keys": ["ip"],
        "action": "rate_limit"
      }
    }
  }
}
